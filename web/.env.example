# Optional cloud sync (Firebase). Copy this file to web/.env.local (git-ignored) and fill it in.
# Leave the values empty to run without sign-in: the sync section is hidden and Firebase isn't built in.
#
# Where to find them: Firebase console → Project settings → General → Your apps → Web app → config.
# These values are public by design (Firestore security rules protect the data). Never put the
# Google "Web client secret" here or anywhere else in the project.
#
# On Vercel: Project → Settings → Environment Variables (Production, and Preview if wanted), then
# redeploy. Vite builds the values into the site, so a new deployment is needed after any change.

# firebaseConfig.apiKey, e.g. AIzaSy...
VITE_FIREBASE_API_KEY=

# firebaseConfig.authDomain, e.g. your-project.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=

# firebaseConfig.projectId, e.g. your-project
VITE_FIREBASE_PROJECT_ID=

# firebaseConfig.appId, e.g. 1:1234567890:web:abc123def456
VITE_FIREBASE_APP_ID=

# Public address of the site, used for robots.txt, sitemap.xml and link previews.
# Defaults to https://pokeplan.albertowd.dev; set it on Vercel when the domain changes.
VITE_SITE_URL=
