{
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "chrome-launcher": "^1.2.2",
    "ffmpeg-static": "^5.3.0",
    "lighthouse": "^13.5.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.19"
  },
  "license": "AGPL-3.0-or-later",
  "name": "dexplanner",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/albertowd/dexplanner.git"
  },
  "scripts": {
    "build": "npm run build -w web",
    "data": "node scripts/build-data.mjs",
    "data:refresh": "node scripts/build-data.mjs --refresh",
    "dev": "npm run dev -w web",
    "lighthouse": "node scripts/lighthouse.mjs",
    "preview": "npm run preview -w web",
    "showcase": "node scripts/showcase.mjs",
    "sonar": "node scripts/sonar.mjs",
    "sonar:down": "docker compose --profile sonar down",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w web"
  },
  "type": "module",
  "version": "1.2.0",
  "workspaces": [
    "web"
  ]
}
